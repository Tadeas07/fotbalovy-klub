          <mxGeometry x="870" y="105" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Decision YES: Insert DB -->
        <mxCell id="fl_yes" value="&lt;b&gt;LOGIKA SPLNĚNA (ANO)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Provedení INSERT INTO hraci&lt;br&gt;PDO Prepared Statement&lt;br&gt;Přesměrování na index.php s úspěchem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="860" y="270" width="240" height="80" as="geometry" />
