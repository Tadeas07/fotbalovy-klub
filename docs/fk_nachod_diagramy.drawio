          <mxGeometry x="80" y="130" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Flowchart Block 2: Parse Year -->
        <mxCell id="fl_step1" value="&lt;b&gt;Extrakce roku narození&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;$rok = date('Y', strtotime($datum))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="310" y="125" width="220" height="60" as="geometry" />
